# ==========================================
# Server Configuration
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# Database (PostgreSQL)
# ==========================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/finance-app

# ==========================================
# Authentication (Better Auth)
# ==========================================
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace_with_a_secure_random_secret_at_least_32_characters
FRONTEND_URL=http://localhost:5173
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174

# ==========================================
# Google OAuth (Optional in dev, required for social login)
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==========================================
# Storage Configuration
# Local development uses MinIO (provided in docker-compose.yml)
# Production uses AWS S3 or Cloudflare R2
# ==========================================
S3_BUCKET=festrack
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/festrack