        "/api/events/me/{eventId}": {
            "get": {
                "summary": "Get an event by ID of the authenticated user",
                "tags": ["Event"],
                "parameters": [
                    {
                        "in": "path",
                        "name": "eventId",
                        "required": true,
                        "type": "string",
                        "description": "Event ID (UUID)"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Event found",
                        "schema": { "$ref": "#/definitions/Event" }
                    },
                    "400": {
                        "description": "Invalid event ID",
