        "/api/users/me/balance": {
            "get": {
                "summary": "Get authenticated user balance",
                "tags": ["User"],
                "parameters": [
                    {
                        "in": "query",
                        "name": "from",
                        "description": "From date (YYYY-MM-DD)",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "date",
                            "example": "2020-01-01"
                        }
                    },
                    {
                        "in": "query",
                        "name": "to",
                        "description": "To date (YYYY-MM-DD)",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "date",
                            "example": "2025-12-31"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User balance",
                        "schema": {
                            "$ref": "#/definitions/UserBalance"
                        }
