{
    "swagger": "2.0",
    "info": {
        "title": "Finance App API",
        "description": "API for FSC Finance App that allows users to manage their finances.",
        "version": "1.0.0"
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header",
            "description": "Enter 'Bearer' followed by your token"
        }
    },
    "security": [
        {
            "BearerAuth": []
        }
    ],
