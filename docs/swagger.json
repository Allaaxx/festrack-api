    "definitions": {
        "User": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "first_name": {
                    "type": "string"
                },
                "last_name": {
                    "type": "string"
                },
                "email": {
                    "type": "string",
                    "format": "email"
                },
                "password": {
                    "type": "string",
                    "format": "password"
                }
            },
            "required": [
                "first_name",
                "last_name",
                "email",
                "password"
            ]
        },
        "UserWithToken": {
            "allOf": [
                {
                    "$ref": "#/definitions/User"
                },
                {
                    "type": "object",
                    "properties": {
                        "accessToken": {
                            "type": "string",
                            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3..."
                        },
                        "refreshToken": {
                            "type": "string",
                            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3..."
                        }
                    }
                }
            ]
        },
        "Tokens": {
            "type": "object",
            "properties": {
                "accessToken": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3..."
                },
                "refreshToken": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3..."
                }
            },
            "required": [
                "accessToken",
                "refreshToken"
            ]
        },
        "UserBalance": {
            "type": "object",
            "properties": {
                "earnings": {
                    "type": "number",
                    "example": "10000"
                },
                "expenses": {
                    "type": "number",
                    "example": "3000"
                },
                "investiments": {
                    "type": "number",
                    "example": "2000"
                },
                "earningsPercentage": {
                    "type": "number",
                    "example": "50"
                },
                "expensePercentage": {
                    "type": "number",
                    "example": "30"
                },
                "investmentsPercentage": {
                    "type": "number",
                    "example": "20"
                },
                "balance": {
                    "type": "number",
                    "example": "5000"
                }
            },
            "required": [
                "balance"
            ]
        },
        "CreateUserParams": {
            "type": "object",
            "properties": {
                "first_name": {
                    "type": "string",
                    "example": "John"
                },
                "last_name": {
                    "type": "string",
                    "example": "Doe"
                },
                "email": {
                    "type": "string",
                    "format": "email",
                    "example": "john@doe.com"
                },
                "password": {
                    "type": "string",
                    "format": "password",
                    "example": "password"
                }
            },
            "required": [
                "first_name",
                "last_name",
                "email",
                "password"
            ]
        },
        "LoginUserParams": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "format": "email",
                    "example": "john@doe.com"
                },
                "password": {
                    "type": "string",
                    "format": "password",
                    "example": "password"
                }
            },
            "required": [
                "email",
                "password"
            ]
        },
        "RefreshTokenParams": {
            "type": "object",
            "properties": {
                "refresh_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIzM2JlMGNiNS01NDEtNDZmNC1hYjEyLTg4NjkwZTY2ZGFvZCIsImV4cCI6MTc1MzI4NDM3Mn0.f3gN8Q-s3gM8Q-s3gM8Q-s3gM8Q-s3gM8Q"
                }
            },
            "required": [
                "refresh_token"
            ]
        },
        "UserNotFoundResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "User not found"
                }
            }
        },
        "Transaction": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "example": "28a47836-8e98-444d-bb59-7b5047b1afd5"
                },
                "user_id": {
                    "type": "string",
                    "example": "33be0cb5-5541-46f4-ab12-88690e66da0d"
                },
                "name": {
                    "type": "string",
                    "example": "Salary"
                },
                "type": {
                    "type": "string",
                    "example": "EARNING",
                    "description": "EARNING | EXPENSE | INVESTIMENT"
                },
