# ==========================================
# Test Environment Configuration
# Used by `bun test` against the isolated test database (postgres-test:5433)
# ==========================================
DATABASE_URL=postgresql://postgres:password@localhost:5433/festrack-app
PORT=8080
NODE_ENV=test

BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=test-better-auth-secret-for-integration-tests
FRONTEND_URL=http://localhost:5174
BETTER_AUTH_TRUSTED_ORIGINS=

# Mock / local storage credentials for test execution
S3_BUCKET=festrack
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-2
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/festrack

GOOGLE_CLIENT_ID=mock-google-client-id
GOOGLE_CLIENT_SECRET=mock-google-client-secret
